# Copy this file to .env before starting Docker Compose.
# The example uses Google for both generation and dense embeddings.
# Do not commit .env or real credentials.

OPENAI_API_KEY=
RETRIEVAL_MODE=hybrid

GOOGLE_API_KEY=
LLM_PROVIDER=google
LLM_MODEL=gemini-3.1-flash-lite
DENSE_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=1536
EMBED_BATCH_SIZE=100

# Internal service URLs used by Docker Compose.
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379/0
RERANKER_URL=http://reranker_service:8001

# To use OpenAI instead, set OPENAI_API_KEY and change:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4.1-mini
# DENSE_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
